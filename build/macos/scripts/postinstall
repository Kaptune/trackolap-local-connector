#!/bin/bash
#
# macOS .pkg postinstall - create the state directory, stage a pairing code, start the
# service.
#
# Unattended install (this is the fleet deployment path - macOS .pkg has no equivalent of
# msiexec properties, so the pairing code arrives through the environment, which `installer`
# passes down to this script):
#
#   sudo TLP_PAIRCODE=ABCD-1234 TLP_SERVER=https://api.trackolap.com \
#        installer -pkg tlp-connector.pkg -target /
#
# Or, with MDM (Jamf/Kandji/Mosyle), deploy the .pkg and then run:
#
#   sudo /usr/local/bin/tlp-connector -pair ABCD-1234
#
set -u

BIN="/usr/local/bin/tlp-connector"
STATE_DIR="/Library/Application Support/TrackOlap/Connector"
LABEL="com.trackolap.connector"
TRAY_LABEL="com.trackolap.connector.tray"
DAEMON_PLIST="/Library/LaunchDaemons/${LABEL}.plist"
AGENT_PLIST="/Library/LaunchAgents/${TRAY_LABEL}.plist"

echo "tlp-connector postinstall: configuring"

# ---------------------------------------------------------------------------
# State directory
# ---------------------------------------------------------------------------
# 0700 root:wheel. connector.json holds the agent's HMAC signing secret; any local user who
# can read it can impersonate this agent against the TrackOlap API. The daemon runs as root,
# so root-only is both sufficient and the tightest option.
mkdir -p "${STATE_DIR}/logs"
chown -R root:wheel "${STATE_DIR}"
chmod 700 "${STATE_DIR}"
chmod 700 "${STATE_DIR}/logs"

# ---------------------------------------------------------------------------
# launchd plist permissions
# ---------------------------------------------------------------------------
# launchd REFUSES to load a daemon plist that is writable by group or other. This is the
# number one reason a .pkg installs cleanly and the service never appears, so it is
# enforced here rather than trusted to the payload's recorded modes.
for plist in "$DAEMON_PLIST" "$AGENT_PLIST"; do
  if [ -f "$plist" ]; then
    chown root:wheel "$plist"
    chmod 644 "$plist"
  fi
done

# ---------------------------------------------------------------------------
# Pairing code (unattended enrollment)
# ---------------------------------------------------------------------------
if [ -n "${TLP_PAIRCODE:-}" ]; then
  echo "  staging the supplied pairing code"
  # -pair writes the code 0600 into the state dir and prints only the path, never the code
  # itself: installer logs end up in /var/log/install.log, which is world-readable.
  if "$BIN" -pair "${TLP_PAIRCODE}" ${TLP_SERVER:+-server "${TLP_SERVER}"}; then
    echo "  pairing code staged"
  else
    # Loud, and fatal. An admin who passed a pairing code deliberately must not be handed a
    # green tick and a fleet of unpaired agents.
    echo "  ERROR: could not stage the pairing code" >&2
    exit 1
  fi
else
  echo "  no TLP_PAIRCODE supplied - pair later with: sudo ${BIN} -pair <code>"
fi

# ---------------------------------------------------------------------------
# Start the service
# ---------------------------------------------------------------------------
# bootstrap is the modern verb; load -w covers macOS 10.13-10.15.
if launchctl bootstrap system "$DAEMON_PLIST" 2>/dev/null; then
  echo "  started ${LABEL}"
elif launchctl load -w "$DAEMON_PLIST" 2>/dev/null; then
  echo "  started ${LABEL} (legacy)"
else
  echo "  WARNING: could not start ${LABEL}; it will start at the next boot" >&2
fi

# Load the tray for anyone already logged in (new logins pick it up on their own).
for uid in $(ps -axo uid,args | awk '/[l]oginwindow console/ {print $1}' | sort -u); do
  launchctl bootstrap "gui/${uid}" "$AGENT_PLIST" 2>/dev/null && echo "  loaded ${TRAY_LABEL} for uid ${uid}"
done

# ---------------------------------------------------------------------------
# Report
# ---------------------------------------------------------------------------
echo "  installed: $("$BIN" -version 2>/dev/null || echo 'version unavailable')"
echo "tlp-connector postinstall: done. Diagnose with: sudo ${BIN} -doctor"
exit 0
