#!/bin/bash
#
# macOS .pkg preinstall - stop a running agent before its binary is replaced.
#
# Without this, an upgrade overwrites /usr/local/bin/tlp-connector underneath a running
# process. On macOS that "works" (the running image keeps the old inode) but leaves the old
# agent alive with the old code until someone reboots, which produces the worst kind of bug
# report: a fix that is installed but not running.
#
# Exiting non-zero here aborts the whole install, so every step is best-effort.
set -u

LABEL="com.trackolap.connector"
TRAY_LABEL="com.trackolap.connector.tray"

echo "tlp-connector preinstall: stopping any running agent"

# bootout is the modern verb; unload is kept for macOS 10.13-10.15.
if launchctl bootout "system/${LABEL}" 2>/dev/null; then
  echo "  stopped ${LABEL}"
elif launchctl unload "/Library/LaunchDaemons/${LABEL}.plist" 2>/dev/null; then
  echo "  unloaded ${LABEL} (legacy)"
else
  echo "  ${LABEL} was not running"
fi

# The tray runs in each logged-in user's session, so it is booted out per GUI session.
for uid in $(ps -axo uid,args | awk '/[l]oginwindow console/ {print $1}' | sort -u); do
  launchctl bootout "gui/${uid}/${TRAY_LABEL}" 2>/dev/null && echo "  stopped ${TRAY_LABEL} for uid ${uid}"
done

exit 0
