<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the TrackOlap Connector menu-bar item.

  Installed to /Library/LaunchAgents/com.trackolap.connector.tray.plist. A LaunchAgent in
  the machine-wide /Library (as opposed to ~/Library) is loaded for EVERY user who logs in,
  which is what an unattended fleet install needs - the installer runs as root and has no
  idea who will actually use the machine.

  This is the tray, not the agent: it draws a menu-bar icon and talks to the daemon's
  localhost console. It must never open the bbolt store, which the daemon holds an
  exclusive lock on.

  NOTE: the tray is not implemented yet. `tlp-connector -tray` currently prints a notice and
  exits 0, so this agent is inert-but-honest rather than a login item that fails. It goes
  live the moment internal/tray lands, with no packaging change.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trackolap.connector.tray</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/tlp-connector</string>
        <string>-tray</string>
    </array>

    <!-- Start at login. -->
    <key>RunAtLoad</key>
    <true/>

    <!--
      No KeepAlive. The tray is a convenience: if the user quits it, it should stay quit
      until the next login. Respawning a menu-bar item the user just dismissed is the
      fastest way to get the whole product uninstalled.

      It also means the current placeholder (-tray exits 0 immediately) does not turn into
      a respawn loop at every login.
    -->
    <key>KeepAlive</key>
    <false/>

    <!--
      Aqua only: no menu bar exists in an ssh or screen-sharing-less session, and launchd
      would otherwise start it in contexts where it can do nothing.
    -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
