<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon for the TrackOlap Connector service.

  Installed to /Library/LaunchDaemons/com.trackolap.connector.plist (root:wheel 0644 - launchd
  REFUSES to load a daemon plist that is group- or world-writable, which is the single most
  common reason a .pkg installs cleanly and the service never appears).

  A daemon, not an agent: it must run with no user logged in, because a Tally box is
  usually a machine sitting in a corner that nobody signs into.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trackolap.connector</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/tlp-connector</string>
        <string>-service</string>
    </array>

    <!-- Start at boot and keep it running. -->
    <key>RunAtLoad</key>
    <true/>

    <!--
      SuccessfulExit=false: restart on a crash, but honour a clean exit. That matters for
      the updater - after a crash-loop rollback the agent exits non-zero and must come back
      on the RESTORED binary, which this does.

      NetworkState=true holds the first start until the machine has a network. Without it
      the agent's first HTTP call races DHCP on a cold boot and logs a spurious failure
      every morning.
    -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>NetworkState</key>
        <true/>
    </dict>

    <!--
      Don't hammer the API if the agent is failing fast (bad config, unreachable server).
      Ten seconds between respawns keeps the logs readable.
    -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>WorkingDirectory</key>
    <string>/Library/Application Support/TrackOlap/Connector</string>

    <!--
      The agent writes its own rotating log (internal/logx). These two catch anything that
      escapes it - a panic, a linker error, an early os.Exit - which is exactly what you
      need when the service "doesn't start" and the agent log is empty.
    -->
    <key>StandardOutPath</key>
    <string>/Library/Application Support/TrackOlap/Connector/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Application Support/TrackOlap/Connector/logs/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <!-- Modest limits: this is a polling agent, not a server. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
</dict>
</plist>
