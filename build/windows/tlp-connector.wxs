<?xml version="1.0" encoding="utf-8"?>
<!--
  TrackOlap Connector - Windows Installer (WiX v4/v5 schema)

  Built on Windows with WiX 5.0.2; see scripts/build-windows.ps1.

  What it installs
    - tlp-connector.exe into %ProgramFiles%\TrackOlap\Connector
    - a Windows service, auto-start (delayed), running as the VIRTUAL service account
      NT SERVICE\tlp-connector - no password to leak, no local user to manage
    - the machine-wide state directory %ProgramData%\TrackOlap\Connector, ACL'd so only
      SYSTEM, Administrators and the service account can read it (it holds the HMAC secret)
    - a Start Menu entry that opens the local console
    - an HKLM ...\Run entry so the desktop tray starts for whoever logs in

  Silent install (this is the deployment path for a fleet):
    msiexec /i tlp-connector.msi /qn PAIRCODE=ABCD-1234 SERVERURL=https://api.trackolap.com

  Silent uninstall:
    msiexec /x tlp-connector.msi /qn

  Every customisable value is an MSI PROPERTY so an admin can set it from the command line
  or an MST/GPO deployment without repackaging.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    UpgradeCode identifies the PRODUCT LINE, not the version. It must never change: a new
    GUID here means Windows treats the next release as a different product and installs it
    side-by-side with the old one, leaving two services fighting over one state directory.
  -->
  <Package
      Name="TrackOlap Connector"
      Manufacturer="TrackOlap"
      Version="$(var.ProductVersion)"
      UpgradeCode="90B68211-D671-4C53-921F-E1EAC346CC9A"
      Scope="perMachine"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation Description="TrackOlap on-premise connector agent" />

    <!--
      Block downgrades with a clear message instead of the default "another version is
      already installed" - support has to read this over the phone.
    -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed. Uninstall it first if you really need to go back." />

    <MediaTemplate EmbedCab="yes" />

    <!-- ==================================================================== -->
    <!-- Properties an administrator can set on the command line               -->
    <!-- ==================================================================== -->

    <!--
      PAIRCODE is a one-time enrollment credential. It is deliberately NOT logged: it is
      passed to tlp-connector.exe -pair, which writes it 0600 into the state directory and
      never echoes it. Secure="yes" lets it survive the elevation boundary on a /qn install.
    -->
    <Property Id="PAIRCODE" Secure="yes" Hidden="yes" />
    <Property Id="SERVERURL" Secure="yes" Value="https://api.trackolap.com" />

    <!--
      Tray autostart, OFF by default.

      The component below is complete and one property away from live. It defaults to 0
      because the shipped binary has no tray: internal/tray only links systray under
      `-tags tray`, which requires CGO_ENABLED=1 and therefore a native (not
      cross-compiled) Windows build. `tlp-connector.exe -tray` in a stock release prints a
      notice and exits - and because the exe is a console subsystem binary, an HKLM Run
      entry would flash a console window at every single logon for no benefit.

      Flip the default to 1 (or pass INSTALLTRAY=1) once tray-tagged Windows builds ship.
    -->
    <Property Id="INSTALLTRAY" Secure="yes" Value="0" />

    <!-- ARP (Add/Remove Programs) presentation. -->
    <Property Id="ARPPRODUCTICON" Value="TlpIcon" />
    <Property Id="ARPHELPLINK" Value="https://www.trackolap.com/support" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.trackolap.com" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Icon Id="TlpIcon" SourceFile="$(var.IconFile)" />

    <!-- ==================================================================== -->
    <!-- Layout                                                                -->
    <!-- ==================================================================== -->

    <!--
      ProgramFiles6432Folder resolves to Program Files on x64 and Program Files (x86) on
      x86, so one .wxs serves every architecture build.
    -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="COMPANYFOLDER" Name="TrackOlap">
        <Directory Id="INSTALLFOLDER" Name="Connector" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="APPMENUFOLDER" Name="TrackOlap" />
    </StandardDirectory>

    <!--
      The state directory is machine-wide (%ProgramData%), not per-user: the service runs
      as a service account with no user profile, and the config it holds is the machine's
      identity, not a person's.
    -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATACOMPANYFOLDER" Name="TrackOlap">
        <Directory Id="DATAFOLDER" Name="Connector" />
      </Directory>
    </StandardDirectory>

    <!-- ==================================================================== -->
    <!-- Components                                                            -->
    <!-- ==================================================================== -->

    <ComponentGroup Id="ProductComponents">

      <!-- The binary + the service registration. -->
      <Component Id="ConnectorExe" Directory="INSTALLFOLDER" Guid="6A2D6DFA-45A4-47CA-9538-70CC867E40E6">
        <File Id="TlpConnectorExe"
              Name="tlp-connector.exe"
              Source="$(var.BinarySource)"
              KeyPath="yes" />

        <!--
          Account="NT SERVICE\tlp-connector" is a VIRTUAL service account: the SCM creates
          and manages it, it has no password (so nothing to store, rotate or steal), and it
          gets only the rights we grant it below. This is what "dedicated low-priv account"
          means on modern Windows - creating a real local user with a password in an MSI
          would be strictly worse.

          Start="auto" registers a supported automatic-start service.

          ErrorControl="normal" means a failure to start is reported but does not stop
          Windows from booting. An accounting integration must never be able to brick a
          customer's machine.
        -->
        <ServiceInstall
            Id="ConnectorServiceInstall"
            Name="tlp-connector"
            DisplayName="TrackOlap Connector"
            Description="Syncs local business applications (Tally, ODBC databases) into TrackOlap."
            Type="ownProcess"
            Start="auto"
            ErrorControl="normal"
            Account="NT SERVICE\tlp-connector"
            Arguments="-service"
            Vital="yes">
          <!-- Come back on our own after a crash instead of staying dead until someone notices. -->
          <util:ServiceConfig
              FirstFailureActionType="restart"
              SecondFailureActionType="restart"
              ThirdFailureActionType="restart"
              RestartServiceDelayInSeconds="30"
              ResetPeriodInDays="1" />
        </ServiceInstall>

        <!--
          Stop+remove on uninstall AND on upgrade. Without Stop/@Remove="both" an upgrade
          leaves the old binary locked by a running service and the file replacement is
          deferred to a reboot.
        -->
        <ServiceControl
            Id="ConnectorServiceControl"
            Name="tlp-connector"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />
      </Component>

      <!--
        The state directory and its ACL.

        CreateFolder + PermissionEx replaces the inherited "Users can read" ACL with an
        explicit list. connector.json holds the agent's HMAC signing secret: any local user
        who can read it can impersonate this agent against the TrackOlap API, so
        NonAdministrator users get nothing at all.
      -->
      <Component Id="StateDirectory" Directory="DATAFOLDER" Guid="1F0F1F4E-6F1E-4E31-9E97-9F2E1E7C7A31">
        <CreateFolder>
          <util:PermissionEx User="SYSTEM"          GenericAll="yes" />
          <util:PermissionEx User="Administrators"  GenericAll="yes" />
          <!--
            The virtual service account. It needs full control of its own state dir: the
            config, the bbolt store and the rotating logs all live here.
          -->
          <util:PermissionEx User="NT SERVICE\tlp-connector" GenericAll="yes" />
        </CreateFolder>
        <!--
          RemoveFolder only deletes an EMPTY directory, which is exactly the behaviour we
          want: an uninstall on a machine that was never paired tidies up completely, while
          an uninstall on a paired machine LEAVES connector.json and the bbolt store behind.
          That is deliberate - an admin who uninstalls to reinstall expects the machine to
          still be paired, and blowing away the agent identity would force them to issue a
          new pairing code and revoke the old agent in the portal.
          To erase it as well:  rmdir /s /q "%ProgramData%\TrackOlap\Connector"
        -->
        <RemoveFolder Id="RemoveDataFolder" Directory="DATAFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveDataCompanyFolder" Directory="DATACOMPANYFOLDER" On="uninstall" />
        <!-- A component needs a keypath; a registry value is the standard choice for a folder-only component. -->
        <RegistryValue Root="HKLM" Key="SOFTWARE\TrackOlap\Connector" Name="StateDirectory"
                       Type="string" Value="[DATAFOLDER]" KeyPath="yes" />
      </Component>

      <!-- Machine-wide install marker + the values support asks for over the phone. -->
      <Component Id="RegistryEntries" Directory="INSTALLFOLDER" Guid="C1B0F0B4-16E5-4B23-9E30-2A3C9E1D2A55">
        <RegistryKey Root="HKLM" Key="SOFTWARE\TrackOlap\Connector" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
          <RegistryValue Name="Version" Type="string" Value="$(var.ProductVersion)" />
          <RegistryValue Name="ServerBaseUrl" Type="string" Value="[SERVERURL]" />
        </RegistryKey>
      </Component>

      <!-- Start Menu: opens the localhost console in the default browser via the agent. -->
      <Component Id="StartMenuShortcut" Directory="APPMENUFOLDER" Guid="E916D10F-A1E6-4889-AF15-8A73B78E6C5D">
        <Shortcut Id="ConsoleShortcut"
                  Name="TrackOlap Connector Console"
                  Description="Configure the TrackOlap connector and view its activity log"
                  Target="[INSTALLFOLDER]tlp-connector.exe"
                  Arguments="-console"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="DoctorShortcut"
                  Name="TrackOlap Connector Diagnostics"
                  Description="Run the connector preflight checks"
                  Target="[INSTALLFOLDER]tlp-connector.exe"
                  Arguments="-doctor"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppMenuFolder" Directory="APPMENUFOLDER" On="uninstall" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\TrackOlap\Connector" Name="StartMenu"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!--
        Tray autostart.

        HKLM\...\Run, not HKCU: a silent fleet deployment runs as SYSTEM, so "the logged-in
        user" is not the installing user. An HKLM Run entry starts the tray for whoever
        actually logs in, which is what the requirement means in practice.

        Gated on INSTALLTRAY, which defaults to 0 - see the property above for why.
      -->
      <Component Id="TrayAutostart" Directory="INSTALLFOLDER" Guid="92F9A8D1-F814-4141-9B9B-60000BF3213C"
                 Condition="INSTALLTRAY = 1">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                       Name="TrackOlapConnectorTray"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]tlp-connector.exe&quot; -tray"
                       KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <Feature Id="Main" Title="TrackOlap Connector" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!-- ==================================================================== -->
    <!-- Silent pairing                                                        -->
    <!-- ==================================================================== -->

    <!--
      When PAIRCODE is supplied, run the installed binary to stage the code into the state
      directory. The agent picks it up and enrolls on its first start.

      Deferred + Impersonate="no" so it runs elevated as SYSTEM after the files are on
      disk. Return="check" on purpose: if an admin explicitly passed a pairing code and it
      could not be staged, the install must fail loudly rather than hand back a green tick
      and a fleet of unpaired agents.

      The code never reaches the MSI log: tlp-connector -pair prints only the file path,
      and PAIRCODE is marked Secure/hidden below.
    -->
    <CustomAction Id="StagePairing"
                  FileRef="TlpConnectorExe"
                  ExeCommand="-pair &quot;[PAIRCODE]&quot; -server &quot;[SERVERURL]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  HideTarget="yes"
                  Return="check" />

    <!-- Hidden="yes" above adds PAIRCODE to WiX-generated MsiHiddenProperties. -->

    <InstallExecuteSequence>
      <!--
        After InstallFiles (the exe exists) and before StartServices (so the agent finds the
        pairing file on its very first start rather than after a poll cycle).
      -->
      <Custom Action="StagePairing" After="InstallFiles" Condition="PAIRCODE AND NOT Installed" />
    </InstallExecuteSequence>

    <!-- ==================================================================== -->
    <!-- UI                                                                    -->
    <!-- ==================================================================== -->

    <!--
      A minimal UI for the interactive case. /qn bypasses all of it, which is the point:
      the same MSI serves a hands-on install and a GPO rollout.
    -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseFile)" />

  </Package>
</Wix>
