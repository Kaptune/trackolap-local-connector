# TrackOlap Connector - systemd unit
#
# Installed to /lib/systemd/system/tlp-connector.service by the .deb / .rpm.
#
# The hardening block below is not decoration. This agent runs inside a customer's network
# with access to their accounting database; the blast radius of a compromised connector is
# the whole box unless it is confined. Everything here is a capability the agent genuinely
# does not need.

[Unit]
Description=TrackOlap Connector
Documentation=https://www.trackolap.com/docs/connector
# network-online, not just network: the agent's first action is an HTTPS call, and
# `network.target` is reached long before an address is actually configured.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/tlp-connector -service
User=trackolap-connector
Group=trackolap-connector

# Always restart, including after a clean exit: the updater exits deliberately after a
# crash-loop rollback and must come back on the restored binary.
Restart=always
RestartSec=10s

# Don't spin forever against a broken config - 5 restarts in 5 minutes and systemd gives
# up, leaving a failed unit that monitoring can see.
StartLimitIntervalSec=300
StartLimitBurst=5

# Give the run loop time to finish an in-flight sync and flush the bbolt store.
TimeoutStopSec=30
KillSignal=SIGTERM

# --- State ------------------------------------------------------------------
# StateDirectory=X creates and chowns /var/lib/X, so X must be spelled exactly as the
# agent's compiled-in path (config.DirFor("linux") = /var/lib/trackolap-connector). Rename
# one without the other and the agent starts, finds an empty directory, and looks unpaired.
StateDirectory=trackolap-connector
StateDirectoryMode=0700
WorkingDirectory=/var/lib/trackolap-connector

# --- Hardening --------------------------------------------------------------
# The agent reads a local app over TCP and writes its own state directory. Nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
# IPv4/IPv6/UNIX only - no raw or packet sockets.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# No capabilities at all: it binds 127.0.0.1:47615 for the console, which is unprivileged.
CapabilityBoundingSet=
AmbientCapabilities=

# ProtectSystem=strict makes everything read-only except what is listed here.
#
# Note what this deliberately excludes: /usr/bin. The self-updater therefore CANNOT swap
# the binary on a packaged Linux install, and that is correct - on Linux the package
# manager owns /usr/bin, and updates arrive through apt/yum like every other package.
# Auto-update is for the Windows and macOS installs, where there is no package manager.
ReadWritePaths=/var/lib/trackolap-connector

# --- Resources --------------------------------------------------------------
LimitNOFILE=4096
# A runaway parse of a huge Tally export should kill the agent, not the customer's box.
MemoryMax=512M
TasksMax=128

# --- Logging ----------------------------------------------------------------
# The agent keeps its own rotating log in the state directory; journald catches whatever
# escapes it (a panic, a linker error) which is what you need when "it won't start".
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tlp-connector

[Install]
WantedBy=multi-user.target
